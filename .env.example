# Copy to .env for local runs (`python -m app` reads it). Every value is optional.
# In Kubernetes these come from the overlay's ConfigMap instead.
APP_NAME=distance-api
APP_ENVIRONMENT=local        # local | ci | staging | production
APP_PORT=8000
APP_LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_FORMAT=text          # json | text
APP_MAX_ROUTE_WAYPOINTS=100
# APP_VERSION is baked into the container image at build time; set it here only
# to see a specific value locally.
# APP_VERSION=0.0.0-dev
